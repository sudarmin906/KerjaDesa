# KerjaDesa Pro production environment
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Required in production
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD

# PostgreSQL connection
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PG_POOL_MAX=10

# Set to the exact frontend origin(s). For a single origin:
# CORS_ORIGIN=https://your-frontend.example
CORS_ORIGIN=https://your-frontend.example

# Frontend only: if API is hosted separately, set this before loading frontend-api-config.js:
# window.KERJADESA_API_BASE = 'https://your-api.example/api'
